  "explanations": {
    "六合": {
      "title": "六合 · 两支相合",
      "meaning": "六合是十二地支中六组固定的两两相合关系，传统上用「合」表达相互联系或结合。这里的「合」是术数分类，不是说两个人一定合得来。",
      "principle": "六组分别为子丑、寅亥、卯戌、辰酉、巳申、午未。每一地支在六合中有一个固定搭配。",
      "example": "例如子鼠与丑牛属于六合；寅虎与亥猪也是六合。",
      "caution": "六合不等于婚姻或合作成功的保证。"
    },
    "三合": {
      "title": "三合 · 三支成局",
      "meaning": "三合把十二地支分成四组，每组三支。传统五行体系将其理解为同一五行气势的组合，分别有水局、金局、火局、木局。",
      "principle": "申子辰为水局、巳酉丑为金局、寅午戌为火局、亥卯未为木局。三支并非在地支顺序上紧挨着。",
      "example": "子鼠、辰龙、申猴同属申子辰三合水局；若只选鼠与龙，是同一三合组中的两支，而不是完整三合。",
      "caution": "不能把同组三个生肖直接换算成性格契合度。"
    },
    "三会": {
      "title": "三会 · 三支会方",
      "meaning": "三会是三个相邻季节地支形成的组合，传统上强调同一季节与方位的五行气势，和三合的分组原则不同。",
      "principle": "寅卯辰会东方木、巳午未会南方火、申酉戌会西方金、亥子丑会北方水。",
      "example": "亥猪、子鼠、丑牛同属亥子丑三会水方；鼠和牛只是其中两支，尚不构成完整三会。",
      "caution": "三会是传统地支组合，并不是生肖之间的社会关系判断。"
    },
    "六冲": {
      "title": "六冲 · 相对的两支",
      "meaning": "六冲是十二地支中六组彼此相对的组合。将十二支依次排成一圈，相隔六位的两支正好相对，因此称为「冲」。",
      "principle": "六组是子午、丑未、寅申、卯酉、辰戌、巳亥。它描述的是地支位置与传统五行关系，并不直接代表争吵。",
      "example": "子鼠与午马相冲；卯兔与酉鸡也相冲。",
      "caution": "不能据此断言两个人必定不和或不宜结婚。"
    },
    "六害": {
      "title": "六害 · 传统相害分类",
      "meaning": "六害又称六穿，是六组固定的地支关系。传统解释常将「害」理解为妨碍、牵制，但各类术数对其具体作用的解释并不完全相同。",
      "principle": "六组是子未、丑午、寅巳、卯辰、申亥、酉戌。它与六冲不是同一套配对。",
      "example": "子鼠与未羊属于六害；酉鸡与戌狗也属于六害。",
      "caution": "「害」是传统术语，不表示某个生肖的人会伤害另一个人。"
    },
    "六破": {
      "title": "六破 · 传统相破分类",
      "meaning": "六破是另一套六组地支关系。「破」在一些传统解释中有破损、失和的象征，但它并不等同于六冲或六害。",
      "principle": "本资料采用子酉、丑辰、寅亥、卯午、巳申、未戌这六组；不同文献对六破的运用与解释可能有差异。",
      "example": "寅虎与亥猪在本资料中既列六合，也列六破。不同分类同时成立并不矛盾，因为它们依据不同规则。",
      "caution": "不能只凭「破」字判断两个人的关系好坏。"
    },
    "六刑": {
      "title": "六刑 · 地支相刑",
      "meaning": "相刑是传统地支关系的一类，常见表述有子卯刑、寅巳申三刑、丑未戌三刑，以及辰、午、酉、亥自刑。不同流派对方向、分组和成立条件有不同解释。",
      "principle": "三刑的三个地支应作为组合背景理解；自刑指同一地支重复出现，并不是两个不同生肖相配。",
      "example": "子鼠与卯兔常被列作子卯相刑；辰龙与辰龙则是常见的「辰辰自刑」说法。",
      "caution": "「刑」是术数概念，不是法律意义的刑罚，也不能预测现实冲突。"
    }
  }
}
