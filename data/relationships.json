  "explanations": {
    "六合": {
      "title": "六合 · 两支相合",
      "meaning": "民间认为这两个生肖比较投缘，容易互相理解、互相扶持。长辈谈婚配、合伙做生意或寻找长期伙伴时，常把六合视为吉利的搭配。",
      "principle": "六组分别为子丑、寅亥、卯戌、辰酉、巳申、午未。每一地支在六合中有一个固定搭配。",
      "example": "例如寅虎与亥猪，民间会说「虎猪六合」，适合互相扶持、结伴或合作。",
      "caution": "以上为民间传统解读，供了解旧时婚配、合作与人际观念。"
    },
    "三合": {
      "title": "三合 · 三支成局",
      "meaning": "传统认为同属一组三合的生肖容易志趣相投、彼此助力，常被说成适合一起做事、发展事业或结交朋友。完整三合由三个生肖组成，两人同组也常被民间称作有缘分。",
      "principle": "申子辰为水局、巳酉丑为金局、寅午戌为火局、亥卯未为木局。三支并非在地支顺序上紧挨着。",
      "example": "例如亥猪、卯兔、未羊为三合木局，传统会说三者容易互相帮衬；猪与兔只是同属这一组。",
      "caution": "以上为民间传统解读，供了解旧时婚配、合作与人际观念。"
    },
    "三会": {
      "title": "三会 · 三支会方",
      "meaning": "传统认为同一三会组的生肖气势相聚、目标容易一致，常用来形容团队齐心、互相带动，尤其偏向群体合作和共同发展。",
      "principle": "寅卯辰会东方木、巳午未会南方火、申酉戌会西方金、亥子丑会北方水。",
      "example": "例如亥猪、子鼠、丑牛为三会水方，民间常借此形容彼此同气、合作有共同方向。",
      "caution": "以上为民间传统解读，供了解旧时婚配、合作与人际观念。"
    },
    "六冲": {
      "title": "六冲 · 相对的两支",
      "meaning": "民间认为相冲的生肖容易观点不同、脾气不合，合作时可能争执较多，婚配上也常被提醒需要磨合。所谓相冲，并不代表一定不能相处。",
      "principle": "六组是子午、丑未、寅申、卯酉、辰戌、巳亥。它描述的是地支位置与传统五行关系，并不直接代表争吵。",
      "example": "例如巳蛇与亥猪相冲，传统会提醒双方做事方式可能不同，沟通时要多些耐心。",
      "caution": "以上为民间传统解读，供了解旧时婚配、合作与人际观念。"
    },
    "六害": {
      "title": "六害 · 传统相害分类",
      "meaning": "传统说法认为相害的生肖容易出现误会、猜疑或暗中牵制，表面看似没问题，却可能因为沟通不足而伤感情。长辈常提醒这类组合要重视信任。",
      "principle": "六组是子未、丑午、寅巳、卯辰、申亥、酉戌。它与六冲不是同一套配对。",
      "example": "例如申猴与亥猪相害，民间会提醒合作时少猜测、多讲清楚，避免误会积累。",
      "caution": "以上为民间传统解读，供了解旧时婚配、合作与人际观念。"
    },
    "六破": {
      "title": "六破 · 传统相破分类",
      "meaning": "民间认为相破的生肖容易出现计划不一致、承诺落空或关系逐渐疏远的情况。若一起做事，传统说法会特别提醒分工清楚、避免互相拆台。",
      "principle": "本资料采用子酉、丑辰、寅亥、卯午、巳申、未戌这六组；不同文献对六破的运用与解释可能有差异。",
      "example": "例如寅虎与亥猪既有六合也有六破说法；按六破解释时，民间会提醒避免因小事损伤信任。",
      "caution": "以上为民间传统解读，供了解旧时婚配、合作与人际观念。"
    },
    "六刑": {
      "title": "六刑 · 地支相刑",
      "meaning": "传统把相刑解释为相处时容易互不相让、互相责怪或产生内耗；三刑通常涉及三支组合。辰辰、午午、酉酉、亥亥等自刑，则常被解释为自己跟自己过不去、反复纠结。",
      "principle": "三刑的三个地支应作为组合背景理解；自刑指同一地支重复出现，并不是两个不同生肖相配。",
      "example": "例如亥猪与亥猪属于常见的亥亥自刑说法，传统解释更侧重反复纠结，而非两人必然冲突。",
      "caution": "以上为民间传统解读，供了解旧时婚配、合作与人际观念。"
    }
  }
}
